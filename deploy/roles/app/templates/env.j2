# ╔══════════════════════════════════════════════════════════════╗
# ║  go-todo-app .env — Managed by Ansible                      ║
# ╚══════════════════════════════════════════════════════════════╝

ENVIRONMENT={{ env }}

# ── Ports ────────────────────────────────────────────────────
GRPC_PORT=9090
HTTP_PORT=8080

# ── Database ─────────────────────────────────────────────────
DATABASE_URL={{ database_url }}

# ── Cache & Queue ────────────────────────────────────────────
MEMCACHED_URL={{ memcached_url }}
REDIS_URL={{ redis_url }}

# ── Security ─────────────────────────────────────────────────
TOKEN_SYMMETRIC_KEY={{ token_symmetric_key }}
ACCESS_TOKEN_DURATION={{ access_token_duration }}
REFRESH_TOKEN_DURATION={{ refresh_token_duration }}

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
GOOGLE_CALLBACK_URL={{ google_callback_url }}

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USERNAME={{ smtp_username }}
SMTP_PASSWORD={{ smtp_password }}
SMTP_FROM={{ smtp_from }}

# ── Scheduler ────────────────────────────────────────────────
REMINDER_CRON={{ reminder_cron }}
REMINDER_WINDOW={{ reminder_window }}
APP_URL={{ app_url }}

LOG_LEVEL=info
