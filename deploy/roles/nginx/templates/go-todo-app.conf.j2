# ╔══════════════════════════════════════════════════════════════╗
# ║  todo-app — Nginx Virtual Host — Managed by Ansible      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Upstream (HTTP) ──────────────────────────────────────────
upstream gotodoapp_http {
    server 127.0.0.1:{{ app_port }};
    keepalive 32;
}

# ── Upstream (gRPC) ──────────────────────────────────────────
upstream gotodoapp_grpc {
    server 127.0.0.1:9090;
    keepalive 32;
}

# ── Redirect HTTP → HTTPS ───────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS Server Block (HTTP/REST) ──────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ server_name }};

    # SSL managed by Certbot
    ssl_certificate     /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    # SSL Security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # ── Logging ──────────────────────────────────────────────
    access_log /var/log/nginx/todo-app/access.log main;
    error_log  /var/log/nginx/todo-app/error.log warn;

    # ── Client Settings ──────────────────────────────────────
    client_max_body_size {{ nginx_client_max_body_size }};

    # ── Locations ────────────────────────────────────────────
    location / {
        limit_req zone=general burst=20 nodelay;
        limit_conn addr 20;

        proxy_pass http://gotodoapp_http;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 30s;
        proxy_send_timeout    60s;
        proxy_read_timeout    120s;

        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # ── Health Check ─────────────────────────────────────────
    location /health {
        proxy_pass http://gotodoapp_http;
        access_log off;
    }

    # ── Deny hidden files ────────────────────────────────────
    location ~ /\. {
        deny all;
        return 404;
    }
}

# ── HTTPS Server Block (gRPC) ───────────────────────────────
server {
    listen 9090 ssl;
    listen [::]:9090 ssl;
    http2 on;
    server_name {{ server_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    access_log /var/log/nginx/todo-app/grpc-access.log main;
    error_log  /var/log/nginx/todo-app/grpc-error.log warn;

    location / {
        grpc_pass grpc://gotodoapp_grpc;

        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        grpc_set_header X-Forwarded-Proto $scheme;

        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
    }
}
